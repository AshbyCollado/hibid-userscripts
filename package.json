{
  "name": "flippah-extension",
  "version": "0.3.37",
  "private": true,
  "type": "module",
  "description": "Flippah browser extension source and HiBid scraper core.",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "npm run typecheck && node build.mjs",
    "install:chrome": "npm run build && node scripts/install-local.mjs",
    "test": "npm run build && tsx --test tests/*.test.ts",
    "test:legacy": "node --test legacy/tampermonkey/tests/*.test.mjs",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true}); require('fs').rmSync('dist-test',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@types/chrome": "^0.0.330",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "jsdom": "^24.1.3",
    "parse5": "^7.3.0",
    "tsx": "^4.20.0",
    "typescript": "^5.6.3"
  }
}
