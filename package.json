{
  "name": "flippah-extension",
  "version": "0.5.43",
  "private": true,
  "type": "module",
  "description": "Flippah browser extension source for HiBid and AuctionNinja research.",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "npm run typecheck && node build.mjs",
    "install:chrome": "npm run build && node scripts/install-local.mjs",
    "test": "npm run build && tsx --test tests/*.test.ts",
    "test:title-corpus": "tsx --test tests/title-corpus-harness.test.ts",
    "materialize:title-corpus": "tsx scripts/title-corpus/materialize.ts",
    "corpus:title": "tsx scripts/title-corpus/run.ts",
    "benchmark:title": "tsx scripts/title-corpus/benchmark.ts",
    "soak:title": "tsx scripts/title-corpus/soak.ts",
    "test:browser:qol": "npm run build && node scripts/smoke-qol.cjs",
    "test:legacy": "node --test legacy/tampermonkey/tests/*.test.mjs",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true}); require('fs').rmSync('dist-test',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@types/chrome": "^0.0.330",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "jsdom": "^24.1.3",
    "parse5": "^7.3.0",
    "tsx": "^4.20.0",
    "typescript": "^5.6.3"
  }
}
